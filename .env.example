# Copie para `.env` e preencha. Variáveis EXPO_PUBLIC_* são embutidas no bundle
# (públicas por design) e lidas via process.env pelo Expo. Reinicie o Expo com
# `npx expo start --clear` depois de alterar.

# URL da API do backend Lucker. Celular físico via Expo Go precisa do IP da
# máquina na rede (NÃO use localhost nem 0.0.0.0 — o celular não os alcança).
EXPO_PUBLIC_API_URL=http://192.168.15.6:8000/api

# Supabase — painel do projeto > Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://<projeto>.supabase.co
# A "anon public" key (NÃO a service_role — essa nunca vai pro app).
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
